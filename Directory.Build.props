<Project>

  <!--
    Shared package metadata for every project in the repository.
    The release pipeline (.github/workflows/publish.yml) reads <Version> from this file,
    so bumping it here is the release act for all packable projects under src/.
    Per-project values (Description, PackageTags, TargetFramework) stay in each .csproj.
  -->
  <PropertyGroup>
    <Version>3.0.0</Version>
    <Authors>Ahmad Omar Al-Freihat</Authors>
    <PackageProjectUrl>https://github.com/a7mdfre7at/Masterly.BusinessRules</PackageProjectUrl>
    <RepositoryUrl>https://github.com/a7mdfre7at/Masterly.BusinessRules</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageIcon>repo_image.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Every packed project ships its XML documentation so consumers get IntelliSense; test projects do not need it. -->
  <PropertyGroup Condition="!$(MSBuildProjectName.EndsWith('.UnitTests'))">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)LICENSE.txt" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)repo_image.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
