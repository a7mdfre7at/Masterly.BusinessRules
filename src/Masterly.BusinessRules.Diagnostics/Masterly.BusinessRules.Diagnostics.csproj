<Project Sdk="Microsoft.NET.Sdk">

  <!-- Version, authors, repository, licence, icon and packed files come from Directory.Build.props. -->
  <PropertyGroup>
    <!-- This package ships its own README.md; only the core package packs the repository README.md. -->
    <PackageReadmeSource>$(MSBuildProjectDirectory)/README.md</PackageReadmeSource>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Description>Structured ILogger observer plus OpenTelemetry ActivitySource spans and Meter instruments for Masterly.BusinessRules rule evaluation.</Description>
    <PackageTags>Rule;Business;Engine;Diagnostics;Logging;OpenTelemetry;Tracing;Metrics;Masterly;Csharp;DotNet</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Masterly.BusinessRules\Masterly.BusinessRules.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
    <PackageReference Include="System.Diagnostics.DiagnosticSource" Version="10.0.14" />
  </ItemGroup>

</Project>
